{
  "name": "@checkapp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.16.3",
    "class-validator": "^0.14.2",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "dotenv": "^17.2.3",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5",
    "@types/pg": "^8.15.6",
    "@types/luxon": "^3.7.1"
  }
}
